# ============================================================================
# VitalTech QGS — environment template
# Copy to .env.local (development) or .env.production (EC2 host).
# In production these values come from AWS Secrets Manager at container start;
# this file is only the documented shape. Never commit real values.
# ============================================================================

# ---- application -----------------------------------------------------------
NODE_ENV=production
APP_URL=https://quotes.vitaltechmyanmar.com
TZ=Asia/Yangon
LOG_LEVEL=info

# ---- database (Amazon RDS, private subnet) ---------------------------------
# App user: DML only, sslmode=require
DATABASE_URL=postgresql://qgs_app:CHANGE_ME@qgs-prod.cluster-xxxx.ap-southeast-1.rds.amazonaws.com:5432/vitaltech_quotes?sslmode=require
# Migration user: DDL only, used by the one-off migrator container
MIGRATION_DATABASE_URL=postgresql://qgs_migrator:CHANGE_ME@qgs-prod.cluster-xxxx.ap-southeast-1.rds.amazonaws.com:5432/vitaltech_quotes?sslmode=require

# ---- auth (Auth.js v5) -----------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
AUTH_URL=https://quotes.vitaltechmyanmar.com
AUTH_TRUST_HOST=true

# ---- AWS -------------------------------------------------------------------
AWS_REGION=ap-southeast-1
S3_BUCKET=vitaltech-qgs-prod
S3_QUOTE_PREFIX=quotes
S3_BRANDING_PREFIX=branding

# ---- scheduled jobs --------------------------------------------------------
# Bearer token required by /api/cron/*; callers are EventBridge Scheduler
FX_CRON_SECRET=CHANGE_ME
# Leave empty to use the free open.er-api.com feed (no key). Set a URL that
# returns USD-based rates or the direct MMK-per-unit shape to override it.
FX_PROVIDER_URL=
FX_API_KEY=

# ---- optional --------------------------------------------------------------
SENTRY_DSN=
PDF_MAX_CONCURRENCY=2
